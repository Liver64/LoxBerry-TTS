#!/usr/bin/env perl
use strict;
use warnings;

sub run_cmd {
    my (@cmd) = @_;
    system(@cmd);
    return ($? >> 8);
}

sub remove_file {
    my ($path) = @_;
    return unless -e $path || -l $path;
    unlink $path or warn "Could not remove $path: $!\n";
}

sub remove_empty_dir {
    my ($path) = @_;
    return unless -d $path;
    rmdir $path or warn "Could not remove non-empty directory $path: $!\n";
}

print "<INFO> Removing Text2Speech MQTT subscriber service ...\n";
run_cmd('/bin/systemctl', 'disable', '--now', 'mqtt-service-tts.service');
remove_file('/etc/systemd/system/mqtt-service-tts.service');

print "<INFO> Removing obsolete Text2Speech Bridge artifacts ...\n";
for my $unit (qw(
    mqtt-watchdog.service
    mqtt-watchdog.timer
    mqtt-handshake-listener.service
    mqtt-handshake-tts.service
)) {
    run_cmd('/bin/systemctl', 'disable', '--now', $unit);
    remove_file("/etc/systemd/system/$unit");
    remove_file("/lib/systemd/system/$unit");
}

for my $path (
    '/etc/mosquitto/t2s-uninstall.pl',
    '/etc/mosquitto/text2speech-uninstall.pl',
    '/etc/mosquitto/uninstall-t2s.pl',
    '/etc/mosquitto/role/t2s-master',
    '/etc/mosquitto/role/text2speech-master',
    '/etc/mosquitto/ca/mosq-ca.crt',
    '/etc/mosquitto/ca/mosq-ca.srl',
    '/etc/mosquitto/ca/private/mosq-ca.key',
    '/etc/mosquitto/certs/mosq-ca.crt',
    '/etc/mosquitto/certs/mosq-ca.key',
    '/etc/mosquitto/certs/t2s.crt',
    '/etc/mosquitto/certs/t2s.key',
    '/etc/mosquitto/certs/t2s.csr',
    '/etc/mosquitto/certs/sip_bridge.crt',
    '/etc/mosquitto/certs/sip_bridge.key',
    '/etc/mosquitto/certs/sip_bridge.csr',
) {
    remove_file($path);
}

# These exact client identities were created exclusively by the former TTS
# Bridge. Unknown client directories below /etc/mosquitto/certs/clients are
# intentionally preserved.
for my $dir (
    '/etc/mosquitto/certs/clients/t2s-bridge',
    '/etc/mosquitto/certs/clients/sip_bridge',
) {
    next unless -d $dir;
    run_cmd('/bin/rm', '-rf', '--one-file-system', $dir);
}

# Remove only these obsolete empty subdirectories. The standard parent
# directories /etc/mosquitto/ca and /etc/mosquitto/certs always remain.
remove_empty_dir('/etc/mosquitto/role');
remove_empty_dir('/etc/mosquitto/ca/private');
remove_empty_dir('/etc/mosquitto/certs/clients');

run_cmd('/bin/systemctl', 'daemon-reload');
run_cmd('/bin/systemctl', 'reset-failed');

print "<OK> Text2Speech service and legacy Bridge cleanup completed. Mosquitto and MQTT Gateway were not restarted or reconfigured.\n";
exit 0;
